---
import { addToCartUrl, type Product } from '../data/store';

interface Props {
  product: Product;
}

const { product } = Astro.props;

const hasDiscount = Boolean(product.discountPct && product.discountPct > 0 && product.compareAtPrice);
const cartUrl = addToCartUrl(product);
const imageSrc = product.image || `https://placehold.co/400x400/efe3fb/6415c8?text=${encodeURIComponent(product.name)}`;
---

<article class="group flex h-full w-full flex-col overflow-hidden rounded-2xl border border-ink/[0.06] bg-surface shadow-sm transition-all duration-300 hover:-translate-y-1 hover:shadow-md">
  <div class="relative aspect-square overflow-hidden bg-surface p-4">
    {hasDiscount && (
      <span class="absolute left-3 top-3 z-10 rounded-full bg-accent px-2.5 py-1 font-display text-[10px] font-bold uppercase tracking-wider text-white">
        -{product.discountPct}%
      </span>
    )}
    <img
      src={imageSrc}
      alt={product.name}
      class="h-full w-full rounded-xl object-contain transition-transform duration-500 group-hover:scale-105"
      loading="lazy"
    />
  </div>

  <div class="flex flex-1 flex-col p-4 pt-2">
    <p class="m-0 font-display text-[11px] font-semibold uppercase tracking-[0.14em] text-muted">{product.brand}</p>
    <h3 class="mt-1 mb-0 line-clamp-2 min-h-[2.6rem] font-display text-sm font-semibold leading-snug text-ink" title={product.name}>
      {product.name}
    </h3>

    <div class="mt-2 flex flex-wrap items-baseline gap-x-2 gap-y-0.5">
      {hasDiscount ? (
        <>
          <span class="text-sm text-muted line-through">{product.compareAtPrice}</span>
          <span class="font-display text-lg font-bold text-accent">{product.unitPrice}</span>
        </>
      ) : (
        <span class="font-display text-lg font-bold text-primary">{product.unitPrice}</span>
      )}
    </div>

    <a
      href={cartUrl}
      data-cross-site={cartUrl.startsWith('http') ? true : undefined}
      class="mt-3 inline-flex min-h-11 w-full items-center justify-center gap-2 rounded-full bg-primary px-4 py-2.5 font-display text-sm font-semibold text-white transition hover:bg-primary-dark active:scale-[0.98]"
    >
      <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <circle cx="9" cy="21" r="1" />
        <circle cx="20" cy="21" r="1" />
        <path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6" />
      </svg>
      Añadir al carrito
    </a>
  </div>
</article>
