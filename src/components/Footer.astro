---
import Logo from './Logo.astro';
import { navCategories, paymentMethods, siteConfig, socialLinks } from '../data/config';

const helpLinks = [
  { label: 'Mi cuenta', href: siteConfig.accountUrl },
  { label: 'Carrito', href: siteConfig.cartUrl },
  { label: 'Comprar online', href: `${siteConfig.storeUrl}/shop/` },
  { label: 'Ofertas', href: `${siteConfig.storeUrl}/ofertas/` },
  { label: 'Elegir sucursal', href: `${siteConfig.storeUrl}/nuestras-tiendas/` },
];

const aboutLinks = [
  { label: 'Nosotros', href: `${siteConfig.storeUrl}/nosotros/` },
  { label: 'Nuestras Tiendas', href: `${siteConfig.storeUrl}/nuestras-tiendas/` },
  { label: 'Catálogo Oliwwi', href: `${siteConfig.url}/catalogo` },
  { label: 'Tienda online', href: `${siteConfig.storeUrl}/shop/` },
];
---

<footer class="bg-ink text-white" data-reveal>
  <!-- Newsletter -->
  <div class="border-b border-white/10">
    <div class="page-shell grid gap-6 py-10 lg:grid-cols-2 lg:items-center">
      <div>
        <h2 id="newsletter-heading" class="m-0 font-display text-2xl font-semibold tracking-tight sm:text-3xl">
          Muy pronto: novedades en tu email
        </h2>
        <p class="mt-2 text-sm text-white/65">
          Estamos preparando el registro por email. Muy pronto podrás recibir novedades y ofertas exclusivas.
        </p>
      </div>
      <form class="flex flex-col gap-3 sm:flex-row" aria-label="Newsletter próximamente">
        <label for="newsletter-email" class="sr-only">Tu email</label>
        <input
          id="newsletter-email"
          name="email"
          type="email"
          placeholder="Newsletter disponible pronto"
          disabled
          class="h-12 flex-1 cursor-not-allowed rounded-full border border-white/20 bg-white/10 px-5 text-sm text-white placeholder:text-white/50"
        />
        <button type="submit" disabled class="min-h-12 shrink-0 cursor-not-allowed rounded-full bg-primary/60 px-6 py-3 font-display text-sm font-semibold text-white/75">
          Próximamente
        </button>
      </form>
    </div>
  </div>

  <!-- Columnas -->
  <div class="page-shell grid gap-10 py-12 sm:grid-cols-2 lg:grid-cols-[1.4fr_repeat(4,1fr)] lg:py-16">
    <div>
      <Logo size="footer" href={siteConfig.url} />
      <p class="mt-4 max-w-sm text-sm leading-relaxed text-white/65">
        Maquillaje, skincare coreano y cuidado personal 100% original. Elige tu sucursal Oliwwi y pide por WhatsApp.
      </p>
      <p class="mt-4 font-display text-lg font-medium text-primary-soft">Be you, Be beautiful.</p>
    </div>

    <nav aria-label="Categorías">
      <h3 class="font-display text-sm font-semibold uppercase tracking-[0.16em] text-primary-soft">Categorías</h3>
      <ul class="mt-4 grid list-none gap-2 p-0 text-sm text-white/70">
        {navCategories.map((category) => (
          <li>
            <a href={category.href} data-cross-site={category.href.startsWith('http') ? true : undefined} class="transition hover:text-white">{category.label}</a>
          </li>
        ))}
        <li>
          <a href={`${siteConfig.storeUrl}/shop/`} data-cross-site class="transition hover:text-white">Todas las marcas</a>
        </li>
      </ul>
    </nav>

    <nav aria-label="Ayuda y soporte">
      <h3 class="font-display text-sm font-semibold uppercase tracking-[0.16em] text-primary-soft">Ayuda</h3>
      <ul class="mt-4 grid list-none gap-2 p-0 text-sm text-white/70">
        {helpLinks.map((link) => (
          <li>
            <a href={link.href} data-cross-site class="transition hover:text-white">{link.label}</a>
          </li>
        ))}
      </ul>
    </nav>

    <nav aria-label="Nosotros e información legal">
      <h3 class="font-display text-sm font-semibold uppercase tracking-[0.16em] text-primary-soft">Nosotros</h3>
      <ul class="mt-4 grid list-none gap-2 p-0 text-sm text-white/70">
        {aboutLinks.map((link) => (
          <li>
            <a href={link.href} data-cross-site class="transition hover:text-white">{link.label}</a>
          </li>
        ))}
      </ul>
    </nav>

    <div>
      <h3 class="font-display text-sm font-semibold uppercase tracking-[0.16em] text-primary-soft">Redes</h3>
      <div class="mt-4 grid gap-2 text-sm text-white/70">
        {socialLinks.map((social) => (
          <a href={social.href} target="_blank" rel="noopener noreferrer" class="flex items-center gap-2 transition hover:text-white">
            <svg class="h-5 w-5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              {social.icon === 'instagram' && (
                <g fill="none" stroke="currentColor" stroke-width="2">
                  <rect x="3" y="3" width="18" height="18" rx="5" />
                  <circle cx="12" cy="12" r="4" />
                  <circle cx="17.5" cy="6.5" r="0.8" fill="currentColor" stroke="none" />
                </g>
              )}
              {social.icon === 'tiktok' && (
                <path d="M16.1 19.2V8.8c0-.7-.7-1.3-1.5-1.3h-3.2c-.8 0-1.5.6-1.5 1.3v10.4c0 .7.7 1.3 1.5 1.3h3.2c.8 0 1.5-.6 1.5-1.3zm-9.2-12.2c0-1.6 1.3-2.9 2.9-2.9s2.9 1.3 2.9 2.9-1.3 2.9-2.9 2.9-2.9-1.3-2.9-2.9zm13.4 13.8c-.9 2.8-3 5-5.7 5.5v-2.5c1.8-.3 3.2-1.9 3.2-3.9 0-1.6-1.3-2.9-2.9-2.9s-2.9 1.3-2.9 2.9c0 .9.5 1.7 1.3 2.1-.7.2-1.4.4-2.1.5v2.6c3.6-.7 6.4-3.2 6.4-6.4z" />
              )}
              {social.icon === 'facebook' && (
                <path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z" />
              )}
            </svg>
            <span>{social.name}</span>
          </a>
        ))}
      </div>
    </div>
  </div>

  <!-- Métodos de pago + legal -->
  <div class="border-t border-white/10 py-6">
    <div class="page-shell flex flex-col items-center justify-between gap-4 text-xs text-white/45 sm:flex-row">
      <p class="m-0">© {new Date().getFullYear()} Oliwwi · Ecuador</p>
      <div class="flex flex-wrap items-center justify-center gap-2" aria-label="Métodos de pago aceptados">
        {paymentMethods.map((method) => (
          <span class="rounded-md border border-white/15 bg-white/5 px-2.5 py-1 font-display text-[10px] font-semibold uppercase tracking-wide text-white/60">
            {method}
          </span>
        ))}
      </div>
      <div class="flex items-center gap-4">
        <a href={`${siteConfig.storeUrl}/nosotros/`} data-cross-site class="transition hover:text-white">Nosotros</a>
        <a href={`${siteConfig.storeUrl}/nuestras-tiendas/`} data-cross-site class="transition hover:text-white">Tiendas</a>
        <a href={`${siteConfig.storeUrl}/shop/`} data-cross-site class="transition hover:text-white">Comprar</a>
      </div>
    </div>
  </div>
</footer>
