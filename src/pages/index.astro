---
import Layout from '../layouts/Layout.astro';
import HeroCarousel from '../components/HeroCarousel.astro';
import BrandMarquee from '../components/BrandMarquee.astro';
import BenefitsStrip from '../components/BenefitsStrip.astro';
import BrandGrid from '../components/BrandGrid.astro';
import ProductCarousel from '../components/ProductCarousel.astro';
import BannerCTA from '../components/BannerCTA.astro';
import BranchesSection from '../components/BranchesSection.astro';
import SocialSection from '../components/SocialSection.astro';
import Newsletter from '../components/Newsletter.astro';
import { products } from '../data/store';
import { siteConfig } from '../data/config';
---

<Layout
  title="Oliwwi | Maquillaje y skincare en Ecuador"
  description="Maquillaje, skincare coreano y cuidado personal 100% original. Elige tu sucursal Oliwwi y pide por WhatsApp."
>
  <!-- Hero Carousel -->
  <HeroCarousel />

  <!-- Benefits Strip -->
  <BenefitsStrip />

  <!-- Brand Marquee -->
  <BrandMarquee />

  <!-- Compra por Marca -->
  <BrandGrid />

  <!-- Product Carousels -->
  <ProductCarousel
    title="Novedades"
    subtitle="Llegaron tus nuevos favoritos"
    products={products}
    ctaText="Ver catálogo completo"
    ctaLink={`${siteConfig.storeUrl}/shop/`}
  />

  <ProductCarousel
    title="Ofertas de la semana"
    subtitle="Descuentos exclusivos por tiempo limitado"
    products={products}
    ctaText="Ver todas las ofertas"
    ctaLink={`${siteConfig.storeUrl}/ofertas/`}
    showDiscountOnly={true}
  />

  <!-- Banner CTA -->
  <BannerCTA
    image="/img/banner-1.jpg"
    alt="Skincare sin género"
    headline="El skincare no tiene género"
    subhead="Descubre tu rutina ideal con productos que cuidan tu piel"
    ctaText="Encuentra tu rutina ideal aquí"
    ctaLink={`${siteConfig.storeUrl}/shop/`}
    ctaVariant="outline"
    position="center"
  />

  <!-- Sucursales -->
  <BranchesSection />

  <!-- Banner CTA 2 -->
  <BannerCTA
    image="/img/banner-2.jpg"
    alt="Ofertas de temporada"
    headline="Tus favoritos, mejor precio"
    subhead="Descuentos exclusivos en marcas que amas. Solo por tiempo limitado."
    ctaText="Ver todas las ofertas"
    ctaLink={`${siteConfig.storeUrl}/ofertas/`}
    ctaVariant="primary"
    position="right"
  />

  <!-- Social / Instagram -->
  <SocialSection />

  <!-- Newsletter -->
  <Newsletter />
</Layout>