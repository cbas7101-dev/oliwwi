---
import { branches } from '../data/store';
---

<!-- Sucursales -->
<section id="sucursales" class="section-space bg-blush" aria-labelledby="sucursales-heading" data-reveal>
  <div class="page-shell">
    <header class="mb-12 text-center lg:text-left max-w-2xl mx-auto lg:mx-0" data-reveal>
      <span class="eyebrow">Pasate a saludar</span>
      <h2 id="sucursales-heading" class="font-display text-4xl font-semibold leading-none tracking-tight text-ink sm:text-5xl mt-2">
        Nuestras Tiendas
      </h2>
      <p class="mt-5 max-w-md leading-relaxed text-muted mx-auto lg:mx-0">
        Seis ciudades, un solo equipo. Elige tu sucursal y tu pedido llega al WhatsApp de esa tienda.
      </p>
    </header>

    <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3" data-reveal>
      {branches.map((branch) => {
        const available = !!branch.phoneInternational;
        const waUrl = available
          ? `https://wa.me/${branch.phoneInternational.replace(/[^0-9]/g, '')}`
          : '';
        return (
          <article class="relative bg-white rounded-2xl border border-ink/10 p-6 hover:shadow-card transition-all duration-300" data-reveal>
            <span class="absolute top-4 right-4 px-3 py-1 rounded-full text-[10px] font-bold uppercase tracking-wider { available ? 'bg-green-100 text-green-700' : 'bg-amber-100 text-amber-700' }">
              {available ? 'Disponible' : 'Próximamente'}
            </span>

            <div class="mb-4 flex items-center justify-center">
              <div class="w-14 h-14 rounded-2xl bg-brand-pale flex items-center justify-center text-brand" aria-hidden="true">
                <svg class="h-7 w-7" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M3 9.5 12 3l9 6.5" />
                  <path d="M5 10v10h14V10" />
                  <path d="M9 20v-6h6v6" />
                </svg>
              </div>
            </div>

            <h3 class="font-display text-xl font-semibold text-ink mb-1">{branch.name}</h3>
            <p class="text-sm leading-relaxed text-muted mb-2">{branch.address}</p>
            <p class="text-xs font-semibold text-ink/65 mb-4">{branch.schedule}</p>

            <div class="flex items-center gap-3 pt-4 border-t border-ink/10">
              {available && (
                <a href={waUrl} target="_blank" rel="noreferrer noopener" class="flex-1 inline-flex items-center justify-center gap-2 px-4 py-2.5 rounded-full bg-brand text-white font-display text-sm font-semibold hover:bg-brand-dark transition">
                  <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3 19.5 19.5 0 0 1-6-6 19.8 19.8 0 0 1-3-8.7A2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1.9.3 1.8.6 2.6a2 2 0 0 1-.4 2.1L8.1 9.6a16 16 0 0 0 6 6l1.2-1.2a2 2 0 0 1 2.1-.4c.9.3 1.7.5 2.6.6a2 2 0 0 1 1.7 2Z" />
                  </svg>
                  <span>{branch.phoneDisplay}</span>
                </a>
              )}
              <span class="flex-1 inline-flex items-center justify-center gap-2 px-4 py-2.5 rounded-full border border-ink/10 bg-white font-display text-sm font-semibold text-ink hover:bg-brand-pale hover:text-brand transition">
                <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5" /></svg>
                Elegir
              </span>
            </div>
          </article>
        );
      })}
    </div>

    <div class="mt-10 text-center" data-reveal>
      <a href="/sucursales" class="button-secondary inline-flex">Ver mapa completo</a>
    </div>
  </div>
</section>