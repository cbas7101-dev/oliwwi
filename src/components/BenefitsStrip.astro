---
import { benefits } from '../data/config';
import Icon from './Icon.astro';
---

<!-- Benefits Strip -->
<section class="py-8 bg-cream border-y border-ink/05" aria-label="Beneficios de Oliwwi">
  <div class="page-shell">
    <div class="grid grid-cols-2 lg:grid-cols-5 gap-6">
      {benefits.map((benefit) => (
        <article class="text-center group">
          <div class="inline-flex items-center justify-center w-12 h-12 mx-auto mb-3 group-hover:scale-110 transition-transform duration-300">
            <Icon name={benefit.icon} class="h-7 w-7 text-brand" strokeWidth={2} />
          </div>
          <h3 class="font-display text-sm font-semibold text-ink mb-1">{benefit.title}</h3>
          <p class="text-xs text-muted">{benefit.desc}</p>
        </article>
      ))}
    </div>
  </div>
</section>