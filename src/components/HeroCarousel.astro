---
import { heroSlides } from '../data/config';
---

<div class="relative w-full overflow-hidden" id="hero-carousel">
  <div class="grid" id="hero-track" style="grid-template-columns: repeat(4, 100%);">
    {heroSlides.map((slide, i) => (
      <div class="relative min-w-0" data-index={i}>
        <img
          src={slide.image}
          alt={slide.alt}
          class="w-full h-[520px] sm:h-[600px] object-cover"
          loading="eager"
        />
        <div class="absolute inset-0 bg-gradient-to-r from-primary/55 via-primary/25 to-transparent" />
        <div class="absolute inset-0 flex items-center page-shell">
          <div class="w-full max-w-2xl">
            <span class="inline-block px-3 py-1 rounded-full bg-white/90 backdrop-blur text-xs font-display font-semibold text-brand tracking-wide mb-4">
              {slide.subhead.split('·')[0].trim()}
            </span>
            <h1 class="font-display text-4xl sm:text-5xl lg:text-6xl font-semibold leading-none tracking-tight text-white mb-4 drop-shadow-lg">
              {slide.headline}
            </h1>
            <p class="text-base sm:text-lg text-white/90 mb-6 max-w-md drop-shadow">
              {slide.subhead.split('·').slice(1).join('·').trim() || slide.subhead}
            </p>
            <div class="flex flex-col sm:flex-row gap-3">
              <a
                href={slide.ctaLink}
                data-cross-site={slide.ctaLink.startsWith('http') ? true : undefined}
                class="inline-flex items-center justify-center gap-2 px-6 py-3 rounded-full bg-brand text-white font-display font-semibold text-sm hover:bg-brand-dark transition shadow-soft"
              >
                {slide.ctaText}
                <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 12h14M12 5l7 7-7 7" /></svg>
              </a>
              <a
                href={slide.secondaryLink}
                data-cross-site={slide.secondaryLink.startsWith('http') ? true : undefined}
                class="inline-flex items-center justify-center gap-2 px-6 py-3 rounded-full bg-white/10 backdrop-blur text-white font-display font-medium text-sm hover:bg-white/20 transition border border-white/30"
              >
                {slide.secondaryText}
              </a>
            </div>
          </div>
        </div>
      </div>
    ))}
  </div>

  <!-- Navigation Arrows -->
  <button
    id="hero-prev"
    class="absolute left-4 top-1/2 -translate-y-1/2 z-10 p-2 rounded-full bg-white/90 backdrop-blur text-ink hover:bg-white transition shadow-lg"
    aria-label="Slide anterior"
  >
    <svg class="h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M15 18l-6-6 6-6" /></svg>
  </button>
  <button
    id="hero-next"
    class="absolute right-4 top-1/2 -translate-y-1/2 z-10 p-2 rounded-full bg-white/90 backdrop-blur text-ink hover:bg-white transition shadow-lg"
    aria-label="Slide siguiente"
  >
    <svg class="h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M9 18l6-6-6-6" /></svg>
  </button>

  <!-- Dots -->
  <div class="absolute bottom-6 left-1/2 -translate-x-1/2 flex gap-2 z-10" id="hero-dots" role="tablist" aria-label="Navegación del carrusel">
    {heroSlides.map((_, i) => (
      <button
        class:list={['h-2.5 rounded-full transition hover:bg-white', i === 0 ? 'w-8 bg-white' : 'w-2.5 bg-white/50']}
        data-index={i}
        role="tab"
        aria-selected={i === 0}
        aria-label={`Ir al slide ${i + 1}`}
      ></button>
    ))}
  </div>
</div>

<script>
  const track = document.getElementById('hero-track') as HTMLElement | null;
  const prevBtn = document.getElementById('hero-prev');
  const nextBtn = document.getElementById('hero-next');
  const dotsContainer = document.getElementById('hero-dots');
  const slides = track ? Array.from(track.children) : [];
  const dots = dotsContainer ? Array.from(dotsContainer.children) : [];

  if (!track || slides.length === 0) {
    prevBtn?.remove();
    nextBtn?.remove();
    dotsContainer?.remove();
  } else {
    const heroTrack = track;
    let currentIndex = 0;
    const slideCount = slides.length;
    let autoplayInterval: number;

    function goToSlide(index: number, instant = false) {
      currentIndex = (index + slideCount) % slideCount;
      const translateX = -currentIndex * (100 / slideCount);

      heroTrack.style.transition = instant ? 'none' : 'transform 700ms ease-out';
      heroTrack.style.transform = `translateX(${translateX}%)`;

      if (instant) {
        void heroTrack.offsetHeight;
        heroTrack.style.transition = 'transform 700ms ease-out';
      }

      updateDots();
    }

    function updateDots() {
      dots.forEach((dot, i) => {
        dot.classList.toggle('bg-white', i === currentIndex);
        dot.classList.toggle('w-8', i === currentIndex);
        dot.classList.toggle('bg-white/50', i !== currentIndex);
        dot.setAttribute('aria-selected', (i === currentIndex).toString());
      });
    }

    function nextSlide() { goToSlide(currentIndex + 1); }
    function prevSlide() { goToSlide(currentIndex - 1); }

    function startAutoplay() {
      autoplayInterval = window.setInterval(nextSlide, 5000);
    }
    function stopAutoplay() { clearInterval(autoplayInterval); }

    prevBtn?.addEventListener('click', () => {
      prevSlide();
      stopAutoplay();
      startAutoplay();
    });
    nextBtn?.addEventListener('click', () => {
      nextSlide();
      stopAutoplay();
      startAutoplay();
    });

    dots.forEach((dot, i) => {
      dot.addEventListener('click', () => {
        goToSlide(i);
        stopAutoplay();
        startAutoplay();
      });
    });

    heroTrack.addEventListener('mouseenter', stopAutoplay);
    heroTrack.addEventListener('mouseleave', startAutoplay);

    document.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowLeft') {
        prevSlide();
        stopAutoplay();
        startAutoplay();
      }
      if (e.key === 'ArrowRight') {
        nextSlide();
        stopAutoplay();
        startAutoplay();
      }
    });

    startAutoplay();
  }
</script>

<style>
  #hero-track {
    display: grid;
    grid-template-columns: repeat(4, 100%);
    transition: transform 700ms ease-out;
  }
  #hero-track > div {
    min-width: 0;
  }
</style>
