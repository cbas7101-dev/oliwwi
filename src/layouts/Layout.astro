---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ScrollReveal from '../components/react/ScrollReveal';

interface Props {
	title?: string;
	description?: string;
}

const {
	title = 'Oliwwi | Maquillaje y skincare en Ecuador',
	description = 'Maquillaje, skincare coreano y cuidado personal 100% original. Elige tu sucursal Oliwwi y pide por WhatsApp.'
} = Astro.props;
---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="generator" content={Astro.generator} />
		<meta name="description" content={description} />
		<meta name="theme-color" content="#F5299E" />
		<title>{title}</title>
	</head>
	<body>
		<Header />
		<main><slot /></main>
		<Footer />
		<ScrollReveal client:load />
		<script>
			const allowedCampaignParams = new Set(['gclid', 'fbclid']);
			const campaignParams = new URLSearchParams(window.location.search);

			document.querySelectorAll<HTMLAnchorElement>('a[data-cross-site]').forEach((link) => {
				const target = new URL(link.href, window.location.origin);
				campaignParams.forEach((value, key) => {
					if (key.startsWith('utm_') || allowedCampaignParams.has(key)) {
						target.searchParams.set(key, value);
					}
				});
				link.href = target.toString();
			});

			document.querySelectorAll<HTMLFormElement>('form[action^="https://tienda.oliwwi.com"]').forEach((form) => {
				campaignParams.forEach((value, key) => {
					if (!key.startsWith('utm_') && !allowedCampaignParams.has(key)) return;
					const input = document.createElement('input');
					input.type = 'hidden';
					input.name = key;
					input.value = value;
					form.appendChild(input);
				});
			});
		</script>
	</body>
</html>
