---
interface Props {
  title: string;
  subtitle?: string;
  products: import('../data/store').Product[];
  ctaText?: string;
  ctaLink?: string;
  showDiscountOnly?: boolean;
}

const { title, subtitle, products, ctaText, ctaLink, showDiscountOnly } = Astro.props;

const filteredProducts = showDiscountOnly
  ? products.filter(p => p.discountPct && p.discountPct > 0)
  : products;
---

<!-- Product Carousel -->
<section class="section-space bg-cream" aria-labelledby={`carousel-${title.toLowerCase().replace(/\s+/g, '-')}`}>
  <div class="page-shell">
    <header class="mb-9 flex flex-col gap-5 sm:flex-row sm:items-end sm:justify-between" data-reveal>
      <div>
        {subtitle && <span class="eyebrow">{subtitle}</span>}
        <h2 id={`carousel-${title.toLowerCase().replace(/\s+/g, '-')}`} class="font-display text-4xl font-semibold leading-none tracking-tight text-ink sm:text-5xl">{title}</h2>
      </div>
      {ctaText && ctaLink && (
        <a href={ctaLink} class="button-secondary self-start sm:self-auto">{ctaText}</a>
      )}
    </header>

    <div class="relative">
      <div class="flex gap-5 overflow-x-auto scroll-smooth pb-6 snap-x -mx-6 px-6" id={`carousel-${title.toLowerCase().replace(/\s+/g, '-')}`} style="scroll-snap-type: x mandatory;">
        {filteredProducts.map((product) => (
          <article class="flex-shrink-0 w-64 sm:w-72 lg:w-80 snap-start rounded-2xl bg-white border border-ink/05 shadow-soft overflow-hidden group relative" data-reveal>
            <!-- Discount Badge -->
            {product.discountPct && product.discountPct > 0 && (
              <span class="absolute top-3 left-3 z-10 px-2.5 py-1 rounded-full bg-red-500 text-white font-display font-bold text-[10px] uppercase tracking-wider">
                -{product.discountPct}%
              </span>
            )}

            <!-- Product Image -->
            <div class="aspect-square relative overflow-hidden">
              <img
                src={product.image || `https://placehold.co/400x400/fceef1/e92672?text=${encodeURIComponent(product.name)}`}
                alt={product.name}
                class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                loading="lazy"
              />
            </div>

            <!-- Hover Actions -->
            <div class="absolute bottom-0 left-0 right-0 p-4 translate-y-full opacity-0 group-hover:translate-y-0 group-hover:opacity-100 transition-all duration-300 bg-gradient-to-t from-ink/90 via-ink/10 to-transparent flex items-center justify-center gap-3">
              <button
                class="p-2.5 rounded-full bg-white text-brand hover:bg-brand hover:text-white transition"
                aria-label={`Agregar ${product.name} al carrito`}
              >
                <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                  <circle cx="9" cy="21" r="1" />
                  <circle cx="20" cy="21" r="1" />
                  <path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6" />
                </svg>
              </button>
              <button
                class="p-2.5 rounded-full bg-white/10 text-white hover:bg-white/20 transition"
                aria-label={`Agregar ${product.name} a favoritos`}
              >
                <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20.84 4.61a5.5 5.5 0 0 1 0 7.78l-6.36 6.36a1 1 0 0 1-1.42 0L3.16 12.39a5.5 5.5 0 0 1 0-7.78 5.5 5.5 0 0 1 7.78 0l1.06 1.06" /></svg>
              </button>
            </div>
          </article>
        ))}
      </div>

      <!-- Scroll hint arrows (optional, for desktop) -->
      <button class="hidden lg:flex absolute left-0 top-1/2 -translate-y-1/2 -ml-6 z-10 p-2 rounded-full bg-white shadow-lg hover:bg-brand-pale transition" aria-label="Scrollear a la izquierda">
        <svg class="h-6 w-6 text-ink" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M15 18l-6-6 6-6" /></svg>
      </button>
      <button class="hidden lg:flex absolute right-0 top-1/2 -translate-y-1/2 -mr-6 z-10 p-2 rounded-full bg-white shadow-lg hover:bg-brand-pale transition" aria-label="Scrollear a la derecha">
        <svg class="h-6 w-6 text-ink" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M9 18l6-6-6-6" /></svg>
      </button>
    </div>
  </div>
</section>