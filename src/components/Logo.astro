---
import { Image } from 'astro:assets';

interface Props {
  size?: 'header' | 'footer';
}

const { size = 'header' } = Astro.props;
const dimensions = size === 'header' ? 58 : 78;
---

<a href="/" class="inline-flex shrink-0 items-center rounded-2xl focus-visible:ring-offset-white" aria-label="Oliwwi, ir al inicio">
  <Image
    src="/logo.jpeg"
    alt="Oliwwi Makeup"
    width={dimensions}
    height={dimensions}
    class:list={['object-cover', size === 'header' ? 'h-[58px] w-[58px] rounded-2xl' : 'h-[78px] w-[78px] rounded-[1.4rem]']}
  />
</a>
