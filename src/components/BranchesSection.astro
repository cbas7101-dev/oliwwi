---
import { branches } from '../data/store';
---

<section id="sucursales" class="section-space bg-blush scroll-mt-24">
  <div class="page-shell">
    <div class="grid gap-5 lg:grid-cols-[0.7fr_1.3fr] lg:gap-12">
      <div data-reveal>
        <span class="eyebrow">Estamos cerquita</span>
        <h2 class="max-w-[9ch] font-display text-4xl font-semibold leading-none tracking-tight text-ink sm:text-5xl">Seis ciudades, el mismo amor.</h2>
        <p class="mt-5 max-w-md leading-relaxed text-muted">Visítanos y encuentra tus favoritos en persona. Te esperamos con mucho amor.</p>
      </div>
      <div class="grid gap-x-8 md:grid-cols-2" data-reveal>
        {branches.map((branch) => (
          <article class="border-t border-ink/15 py-5">
            <div class="mb-3 flex items-center justify-between gap-3">
              <h3 class="font-display text-xl font-semibold text-ink">{branch.name}</h3>
              <span class:list={['rounded-full px-2.5 py-1 text-[10px] font-bold uppercase tracking-wider', branch.phoneInternational ? 'bg-white text-brand-dark' : 'bg-ink/5 text-muted']}>{branch.phoneInternational ? 'Disponible' : 'Próximamente'}</span>
            </div>
            <p class="min-h-10 text-sm leading-relaxed text-muted">{branch.address}</p>
            <p class="mt-3 text-xs font-semibold text-ink/65">{branch.schedule}</p>
            {branch.phoneInternational ? (
              <a href={`https://wa.me/${branch.phoneInternational}`} target="_blank" rel="noreferrer" class="mt-4 inline-flex items-center gap-2 font-display text-sm font-semibold text-brand-dark transition hover:text-brand">
                {branch.phoneDisplay}
                <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M5 12h14m-5-5 5 5-5 5" /></svg>
              </a>
            ) : <span class="mt-4 inline-block font-display text-sm font-semibold text-muted">Pedidos próximamente</span>}
          </article>
        ))}
      </div>
    </div>
  </div>
</section>
