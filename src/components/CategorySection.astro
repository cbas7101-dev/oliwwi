---
import { siteConfig } from '../data/config';

const categories = [
  { name: 'Maquillaje', note: 'Color que habla por ti', className: 'bg-[#ffd3e2]', icon: 'lip' },
  { name: 'Skincare Coreano', note: 'Tu ritual de cuidado', className: 'bg-[#f6e8d9]', icon: 'drop' },
  { name: 'Cuidado Capilar', note: 'Mimos para tu cabello', className: 'bg-[#ead9e9]', icon: 'wave' },
  { name: 'Cuidado Corporal', note: 'Suave de pies a cabeza', className: 'bg-[#dceeed]', icon: 'spark' }
];
---

<section class="section-space bg-cream">
  <div class="page-shell">
    <div class="mb-9 max-w-2xl" data-reveal>
      <span class="eyebrow">Encuentra lo tuyo</span>
      <h2 class="font-display text-4xl font-semibold leading-none tracking-tight text-ink sm:text-5xl">Belleza para cada mood.</h2>
    </div>
    <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-[1.15fr_0.85fr_0.85fr_1.15fr]" data-reveal>
      {categories.map((category, index) => (
        <a href={`${siteConfig.storeUrl}/shop/`} data-cross-site class:list={['group relative min-h-60 overflow-hidden rounded-[2rem] p-5 transition duration-300 hover:-translate-y-1 sm:min-h-72', category.className, index % 2 === 1 ? 'lg:mt-10' : '']}>
          <svg class="h-8 w-8 text-ink/70 transition duration-300 group-hover:rotate-6 group-hover:scale-110" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" aria-hidden="true">
            {category.icon === 'drop' && <path d="M12 3S6 9.2 6 14a6 6 0 0 0 12 0c0-4.8-6-11-6-11Z" />}
            {category.icon === 'lip' && <><path d="M8 4h8v5H8zM7 9h10v11H7z" /><path d="m9 4 4-2 3 2" /></>}
            {category.icon === 'wave' && <><path d="M4 7c4-4 5 4 9 0s5 4 7 1" /><path d="M4 12c4-4 5 4 9 0s5 4 7 1M4 17c4-4 5 4 9 0s5 4 7 1" /></>}
            {category.icon === 'spark' && <><path d="m12 3 1.5 4.5L18 9l-4.5 1.5L12 15l-1.5-4.5L6 9l4.5-1.5L12 3Z" /><path d="m19 15 .7 2.3L22 18l-2.3.7L19 21l-.7-2.3L16 18l2.3-.7L19 15Z" /></>}
          </svg>
          <div class="absolute inset-x-5 bottom-5">
            <h3 class="max-w-[10ch] font-display text-2xl font-semibold leading-none tracking-tight text-ink">{category.name}</h3>
            <p class="mt-2 text-sm text-ink/60">{category.note}</p>
            <span class="mt-4 inline-flex h-9 w-9 items-center justify-center rounded-full bg-white/70 text-ink transition group-hover:translate-x-1 group-hover:bg-white">
              <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M5 12h14m-5-5 5 5-5 5" /></svg>
            </span>
          </div>
        </a>
      ))}
    </div>
  </div>
</section>
