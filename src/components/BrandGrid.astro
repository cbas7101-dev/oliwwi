---
import { brands, siteConfig } from '../data/config';

const brandBackgrounds = ['bg-[#fce9ef]', 'bg-[#f7eee7]', 'bg-[#eee7f4]', 'bg-[#e8f2ef]', 'bg-[#fff0d9]'];
---

<!-- Compra por Marca -->
<section class="section-space bg-white" aria-labelledby="marcas-heading">
  <div class="page-shell">
    <header class="mb-9 flex flex-col gap-5 sm:flex-row sm:items-end sm:justify-between" data-reveal>
      <div>
        <span class="eyebrow">Compra por marca</span>
        <h2 id="marcas-heading" class="font-display text-4xl font-semibold leading-none tracking-tight text-ink sm:text-5xl">Un favorito para cada ritual.</h2>
      </div>
      <a href={`${siteConfig.storeUrl}/shop/`} data-cross-site class="button-secondary self-start sm:self-auto">Ver todas las marcas</a>
    </header>

    <div class="grid gap-x-8 md:grid-cols-2 lg:grid-cols-3 xl:grid-cols-5" data-reveal>
      {brands.map((brand, index) => (
        <a href={`${siteConfig.storeUrl}/product-category/${brand.slug}/`} data-cross-site class:list={['group relative grid aspect-[16/9] place-items-center overflow-hidden rounded-2xl border border-ink/5 p-8 transition-all duration-500 hover:-translate-y-1 hover:shadow-card', brandBackgrounds[index % brandBackgrounds.length]]}>
          <img src={brand.logo} alt={brand.name} class="max-h-20 w-full max-w-[11rem] object-contain transition-transform duration-500 group-hover:scale-105" loading="lazy" />
          <span class="absolute top-4 right-4 px-3 py-1 rounded-full bg-white/90 backdrop-blur text-xs font-display font-semibold text-brand opacity-0 group-hover:opacity-100 transition-opacity">
            Ver productos
          </span>
        </a>
      ))}
    </div>
  </div>
</section>
