---
import Logo from './Logo.astro';
import { siteConfig, socialLinks } from '../data/config';
---

<footer class="border-t border-ink/10 bg-ink text-white" data-reveal>
  <div class="page-shell grid gap-10 py-12 sm:grid-cols-2 lg:grid-cols-[1.5fr_repeat(4,1fr)] lg:py-16">
    <!-- Brand -->
    <div class="lg:col-span-1">
      <Logo size="footer" />
      <p class="mt-4 max-w-sm text-sm leading-relaxed text-white/65">
        Maquillaje, skincare coreano y cuidado personal 100% original. Elige tu sucursal Oliwwi y pide por WhatsApp.
      </p>
      <p class="mt-4 font-display text-lg font-medium text-brand-soft">Be you, Be beautiful.</p>
    </div>

    <!-- Navegación -->
    <nav aria-label="Navegación principal">
      <h2 class="font-display text-sm font-semibold uppercase tracking-[0.16em] text-brand-soft">Explora</h2>
      <ul class="mt-4 grid gap-2 text-sm text-white/70">
        <li><a href={siteConfig.url} data-cross-site class="transition hover:text-white">Inicio</a></li>
        <li><a href={`${siteConfig.storeUrl}/shop/`} data-cross-site class="transition hover:text-white">Tienda</a></li>
        <li><a href={`${siteConfig.storeUrl}/ofertas/`} data-cross-site class="transition hover:text-white">Ofertas</a></li>
        <li><a href={`${siteConfig.storeUrl}/nuestras-tiendas/`} data-cross-site class="transition hover:text-white">Sucursales</a></li>
        <li><a href={`${siteConfig.storeUrl}/nosotros/`} data-cross-site class="transition hover:text-white">Nosotros</a></li>
      </ul>
    </nav>

    <!-- Ayuda -->
    <nav aria-label="Ayuda y soporte">
      <h2 class="font-display text-sm font-semibold uppercase tracking-[0.16em] text-brand-soft">Ayuda</h2>
      <ul class="mt-4 grid gap-2 text-sm text-white/70">
        <li><a href={`${siteConfig.storeUrl}/faq/`} data-cross-site class="transition hover:text-white">Preguntas Frecuentes</a></li>
        <li><a href={`${siteConfig.storeUrl}/envios/`} data-cross-site class="transition hover:text-white">Envíos y Retiros</a></li>
        <li><a href={`${siteConfig.storeUrl}/pagos/`} data-cross-site class="transition hover:text-white">Métodos de Pago</a></li>
        <li><a href={`${siteConfig.storeUrl}/mayoreo/`} data-cross-site class="transition hover:text-white">Precios de Mayoreo</a></li>
        <li><a href={`${siteConfig.storeUrl}/contacto/`} data-cross-site class="transition hover:text-white">Contáctanos</a></li>
      </ul>
    </nav>

    <!-- Legal -->
    <nav aria-label="Información legal">
      <h2 class="font-display text-sm font-semibold uppercase tracking-[0.16em] text-brand-soft">Legal</h2>
      <ul class="mt-4 grid gap-2 text-sm text-white/70">
        <li><a href={`${siteConfig.storeUrl}/politicas/privacidad/`} data-cross-site class="transition hover:text-white">Política de Privacidad</a></li>
        <li><a href={`${siteConfig.storeUrl}/politicas/terminos/`} data-cross-site class="transition hover:text-white">Términos y Condiciones</a></li>
        <li><a href={`${siteConfig.storeUrl}/politicas/devoluciones/`} data-cross-site class="transition hover:text-white">Devoluciones</a></li>
      </ul>
    </nav>

    <!-- Comunidad / Redes -->
    <div>
      <h2 class="font-display text-sm font-semibold uppercase tracking-[0.16em] text-brand-soft">Comunidad</h2>
      <div class="mt-4 grid gap-2 text-sm text-white/70">
        {socialLinks.map((social) => (
          <a href={social.href} target="_blank" rel="noopener noreferrer" class="transition hover:text-white flex items-center gap-2">
            <svg class="h-5 w-5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              {social.icon === 'instagram' && (
                <g fill="none" stroke="currentColor" stroke-width="2">
                  <rect x="3" y="3" width="18" height="18" rx="5" />
                  <circle cx="12" cy="12" r="4" />
                  <circle cx="17.5" cy="6.5" r="0.8" fill="currentColor" stroke="none" />
                </g>
              )}
              {social.icon === 'tiktok' && (
                <path d="M16.1 19.2V8.8c0-.7-.7-1.3-1.5-1.3h-3.2c-.8 0-1.5.6-1.5 1.3v10.4c0 .7.7 1.3 1.5 1.3h3.2c.8 0 1.5-.6 1.5-1.3zm-9.2-12.2c0-1.6 1.3-2.9 2.9-2.9s2.9 1.3 2.9 2.9-1.3 2.9-2.9 2.9-2.9-1.3-2.9-2.9zm13.4 13.8c-.9 2.8-3 5-5.7 5.5v-2.5c1.8-.3 3.2-1.9 3.2-3.9 0-1.6-1.3-2.9-2.9-2.9s-2.9 1.3-2.9 2.9c0 .9.5 1.7 1.3 2.1-.7.2-1.4.4-2.1.5v2.6c3.6-.7 6.4-3.2 6.4-6.4z" />
              )}
              {social.icon === 'facebook' && (
                <path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z" />
              )}
            </svg>
            <span>{social.name}</span>
          </a>
        ))}
      </div>
    </div>
  </div>

  <div class="border-t border-white/10 py-6">
    <div class="page-shell flex flex-col sm:flex-row items-center justify-between gap-4 text-xs text-white/45">
      <p>© {new Date().getFullYear()} Oliwwi · Ecuador</p>
      <div class="flex items-center gap-4">
        <a href={`${siteConfig.storeUrl}/politicas/privacidad/`} data-cross-site class="transition hover:text-white">Privacidad</a>
        <a href={`${siteConfig.storeUrl}/politicas/terminos/`} data-cross-site class="transition hover:text-white">Términos</a>
        <a href={`${siteConfig.storeUrl}/politicas/cookies/`} data-cross-site class="transition hover:text-white">Cookies</a>
      </div>
    </div>
  </div>
</footer>
