---
import { brands } from '../data/config';
---

<!-- Compra por Marca -->
<section class="section-space bg-white" aria-labelledby="marcas-heading">
  <div class="page-shell">
    <header class="mb-9 flex flex-col gap-5 sm:flex-row sm:items-end sm:justify-between" data-reveal>
      <div>
        <span class="eyebrow">Compra por marca</span>
        <h2 id="marcas-heading" class="font-display text-4xl font-semibold leading-none tracking-tight text-ink sm:text-5xl">Un favorito para cada ritual.</h2>
      </div>
      <a href="/marcas" class="button-secondary self-start sm:self-auto">Ver todas las marcas</a>
    </header>

    <div class="grid gap-x-8 md:grid-cols-2 lg:grid-cols-3 xl:grid-cols-5" data-reveal>
      {brands.map((brand) => (
        <a href={`/catalogo?marca=${brand.slug}`} class="group relative aspect-[16/9] rounded-2xl overflow-hidden bg-cream border border-ink/05 hover:shadow-card transition-all duration-500">
          <img
            src={brand.image}
            alt={brand.name}
            class="absolute inset-0 w-full h-full object-cover group-hover:scale-105 transition-transform duration-700"
            loading="lazy"
          />
          <!-- Solo logo limpio en la esquina inferior izquierda -->
          <div class="absolute bottom-4 left-4 right-4 flex items-end">
            <img src={brand.logo} alt={brand.name} class="h-14 w-auto object-contain drop-shadow-xl group-hover:scale-110 transition-transform" />
          </div>
          <span class="absolute top-4 right-4 px-3 py-1 rounded-full bg-white/90 backdrop-blur text-xs font-display font-semibold text-brand opacity-0 group-hover:opacity-100 transition-opacity">
            Ver productos
          </span>
        </a>
      ))}
    </div>
  </div>
</section>