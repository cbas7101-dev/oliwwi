---
import { campaignImages, siteConfig } from '../data/config';

const socialCards = [
  {
    name: 'Instagram',
    handle: '@oliwwi_ec',
    tagline: 'Fotos, reels y novedades',
    href: 'https://www.instagram.com/oliwwi_ec/',
    image: campaignImages.ritualShelf,
    alt: 'Rutina de cuidado personal en repisa rosada',
    badgeClass: 'text-primary-dark',
  },
  {
    name: 'TikTok',
    handle: '@oliwwi_makeup',
    tagline: 'Videos y tendencias',
    href: 'https://www.tiktok.com/@oliwwi_makeup',
    image: campaignImages.heroGloss,
    alt: 'Modelo aplicándose gloss rosado',
    badgeClass: 'text-black',
  },
  {
    name: 'Telegram',
    handle: '@oliwwi_makeup',
    tagline: 'Canal y comunidad',
    href: 'https://t.me/oliwwi_makeup',
    image: campaignImages.skincareFlatlay,
    alt: 'Productos de skincare en tonos rosados',
    badgeClass: 'text-[#0088cc]',
  },
];

const feedPosts = [
  {
    image: campaignImages.storeShelf,
    alt: 'Repisa de tienda con productos rosados',
    position: '',
    label: '',
    href: 'https://www.instagram.com/oliwwi_ec/',
    crossSite: false,
  },
  {
    image: campaignImages.skincareFlatlay,
    alt: 'Mascarillas, sérums y cremas rosadas sobre mármol',
    position: '',
    label: '',
    href: 'https://www.instagram.com/oliwwi_ec/',
    crossSite: false,
  },
  {
    image: campaignImages.heroGloss,
    alt: 'Gloss rosado aplicado frente al espejo',
    position: 'object-top',
    label: '',
    href: 'https://www.instagram.com/oliwwi_ec/',
    crossSite: false,
  },
  {
    image: campaignImages.ritualShelf,
    alt: 'Selección de productos de cuidado en tonos rosados',
    position: 'object-[50%_25%]',
    label: '',
    href: 'https://www.instagram.com/oliwwi_ec/',
    crossSite: false,
  },
  {
    image: campaignImages.promoGraphic,
    alt: '',
    position: '',
    label: 'Nuevos ingresos',
    href: `${siteConfig.storeUrl}/shop/`,
    crossSite: true,
  },
  {
    image: campaignImages.abstractWarm,
    alt: '',
    position: '',
    label: 'Ofertas de la semana',
    href: `${siteConfig.storeUrl}/ofertas/`,
    crossSite: true,
  },
];
---

<!-- Social / Instagram Feed -->
<section id="redes" class="section-space bg-white" aria-labelledby="social-heading" data-reveal>
  <div class="page-shell">
    <header class="mb-12 text-center lg:text-left max-w-2xl mx-auto lg:mx-0" data-reveal>
      <span class="eyebrow">@oliwwi_ec</span>
      <h2 id="social-heading" class="font-display text-4xl font-semibold leading-none tracking-tight text-ink sm:text-5xl mt-2">
        La comunidad Oliwwi
      </h2>
      <p class="mt-5 max-w-md leading-relaxed text-muted mx-auto lg:mx-0">
        Novedades, promociones y mucho amor. Síguenos para descubrir lanzamientos, fotos y videos de nuestros productos.
      </p>
    </header>

    <!-- Social Cards Grid -->
    <div class="-mx-4 mb-8 flex snap-x gap-4 overflow-x-auto px-4 pb-2 sm:mx-0 sm:grid sm:grid-cols-2 sm:px-0 lg:grid-cols-3" data-reveal>
      {socialCards.map((card) => (
        <a
          href={card.href}
          target="_blank"
          rel="noopener noreferrer"
          class="group relative aspect-square w-[78vw] max-w-[300px] shrink-0 snap-start overflow-hidden rounded-2xl border border-ink/5 bg-ink/20 transition hover:shadow-card sm:w-auto sm:max-w-none"
        >
          <img
            src={card.image}
            alt={card.alt}
            class="absolute inset-0 h-full w-full object-cover transition-transform duration-500 group-hover:scale-105"
            loading="lazy"
          />
          <div class="absolute inset-0 bg-gradient-to-t from-ink/80 via-ink/25 to-transparent" />
          <div class="absolute bottom-4 left-4 right-4 z-10">
            <span class:list={['inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-white font-display font-semibold text-sm', card.badgeClass]}>
              <svg class="h-4 w-4" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                {card.name === 'Instagram' && (
                  <g fill="none" stroke="currentColor" stroke-width="2">
                    <rect x="3" y="3" width="18" height="18" rx="5" />
                    <circle cx="12" cy="12" r="4" />
                    <circle cx="17.5" cy="6.5" r="0.8" fill="currentColor" stroke="none" />
                  </g>
                )}
                {card.name === 'TikTok' && (
                  <path d="M16.1 19.2V8.8c0-.7-.7-1.3-1.5-1.3h-3.2c-.8 0-1.5.6-1.5 1.3v10.4c0 .7.7 1.3 1.5 1.3h3.2c.8 0 1.5-.6 1.5-1.3zm-9.2-12.2c0-1.6 1.3-2.9 2.9-2.9s2.9 1.3 2.9 2.9-1.3 2.9-2.9 2.9-2.9-1.3-2.9-2.9zm13.4 13.8c-.9 2.8-3 5-5.7 5.5v-2.5c1.8-.3 3.2-1.9 3.2-3.9 0-1.6-1.3-2.9-2.9-2.9s-2.9 1.3-2.9 2.9c0 .9.5 1.7 1.3 2.1-.7.2-1.4.4-2.1.5v2.6c3.6-.7 6.4-3.2 6.4-6.4z" />
                )}
                {card.name === 'Telegram' && (
                  <path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z" />
                )}
              </svg>
              {card.name}
            </span>
            <h3 class="mt-4 text-xl font-display font-semibold text-white">{card.handle}</h3>
            <p class="text-white/75 text-sm">{card.tagline}</p>
          </div>
        </a>
      ))}
    </div>

    <!-- Instagram Feed Placeholder -->
    <div data-reveal>
      <p class="text-center text-muted mb-6">Feed de Instagram <span class="text-primary">@oliwwi_ec</span></p>
      <div class="grid grid-cols-2 gap-2 sm:grid-cols-3 lg:grid-cols-6" role="list" aria-label="Posts de Instagram">
        {feedPosts.map((post) => (
          <a
            href={post.href}
            data-cross-site={post.crossSite ? true : undefined}
            target={post.crossSite ? undefined : '_blank'}
            rel={post.crossSite ? undefined : 'noopener noreferrer'}
            class="group relative aspect-square overflow-hidden rounded-xl bg-cream"
            role="listitem"
          >
            <img
              src={post.image}
              alt={post.alt || post.label}
              class:list={['h-full w-full object-cover transition-transform duration-500 group-hover:scale-105', post.position]}
              loading="lazy"
            />
            {post.label ? (
              <div class="absolute inset-0 flex items-center justify-center bg-gradient-to-t from-primary/60 via-primary/20 to-transparent p-2 text-center">
                <span class="font-display text-sm font-semibold uppercase tracking-wide text-white drop-shadow-md sm:text-base">{post.label}</span>
              </div>
            ) : (
              <div class="absolute inset-0 flex items-center justify-center bg-gradient-to-t from-ink/60 via-transparent to-transparent opacity-0 transition-opacity group-hover:opacity-100">
                <svg class="h-10 w-10 text-white" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                  <path d="M8 5v14l11-7z" />
                </svg>
              </div>
            )}
          </a>
        ))}
      </div>
    </div>
  </div>
</section>
