---
import ProductCard from './ProductCard.astro';
import type { Product } from '../data/store';

interface Props {
  title: string;
  subtitle?: string;
  products: Product[];
  ctaText?: string;
  ctaLink?: string;
  showDiscountOnly?: boolean;
}

const { title, subtitle, products, ctaText, ctaLink, showDiscountOnly } = Astro.props;

const filteredProducts = showDiscountOnly
  ? products.filter((p) => p.discountPct && p.discountPct > 0)
  : products;

const sectionId = `carousel-${title.toLowerCase().replace(/[^a-z0-9\s-]/g, '').replace(/\s+/g, '-')}`;
---

<section class="section-space bg-bg" aria-labelledby={`${sectionId}-heading`} id={sectionId} data-product-carousel>
  <div class="page-shell">
    <header class="mb-8 flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between" data-reveal>
      <div>
        {subtitle && <span class="eyebrow">{subtitle}</span>}
        <h2 id={`${sectionId}-heading`} class="m-0">
          <span class="pill-title">{title}</span>
        </h2>
      </div>
      {ctaText && ctaLink && (
        <a href={ctaLink} data-cross-site={ctaLink.startsWith('http') ? true : undefined} class="button-secondary self-start sm:self-auto">{ctaText}</a>
      )}
    </header>

    <div class="relative" data-reveal>
      <div
        class="-mx-4 flex snap-x gap-5 overflow-x-auto scroll-smooth px-4 pb-4 sm:-mx-6 sm:px-6 lg:mx-0 lg:px-1"
        style="scroll-snap-type: x mandatory; scrollbar-width: none; -ms-overflow-style: none;"
        data-carousel-track
      >
        {filteredProducts.map((product) => (
          <div class="w-[70vw] max-w-[260px] shrink-0 snap-start min-[480px]:w-[220px] sm:w-[240px] lg:w-[268px]">
            <ProductCard product={product} />
          </div>
        ))}
      </div>

      <button
        type="button"
        class="absolute -left-2 top-1/2 z-10 hidden h-11 w-11 -translate-y-1/2 place-items-center rounded-full border border-ink/10 bg-surface text-ink shadow-soft transition hover:border-primary/40 hover:text-primary-dark lg:grid"
        aria-label="Ver productos anteriores"
        data-carousel-prev
      >
        <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><path d="m15 18-6-6 6-6" /></svg>
      </button>
      <button
        type="button"
        class="absolute -right-2 top-1/2 z-10 hidden h-11 w-11 -translate-y-1/2 place-items-center rounded-full border border-ink/10 bg-surface text-ink shadow-soft transition hover:border-primary/40 hover:text-primary-dark lg:grid"
        aria-label="Ver productos siguientes"
        data-carousel-next
      >
        <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><path d="m9 18 6-6-6-6" /></svg>
      </button>
    </div>
  </div>
</section>

<script>
  document.querySelectorAll<HTMLElement>('[data-product-carousel] [data-carousel-track]').forEach((track) => {
    const wrapper = track.parentElement;
    if (!wrapper) return;

    const prev = wrapper.querySelector<HTMLButtonElement>('[data-carousel-prev]');
    const next = wrapper.querySelector<HTMLButtonElement>('[data-carousel-next]');

    const step = () => {
      const card = track.querySelector<HTMLElement>(':scope > div');
      return card ? card.offsetWidth + 20 : 300;
    };

    prev?.addEventListener('click', () => {
      track.scrollBy({ left: -step() * 2, behavior: 'smooth' });
    });

    next?.addEventListener('click', () => {
      track.scrollBy({ left: step() * 2, behavior: 'smooth' });
    });
  });
</script>
