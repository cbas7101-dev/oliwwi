---
import Logo from './Logo.astro';
import BranchSelector from './react/BranchSelector';

interface Props {
  currentPath: string;
}

const { currentPath } = Astro.props;
const links = [
  { href: '/', label: 'Inicio' },
  { href: '/catalogo', label: 'Catálogo' },
  { href: '/#sucursales', label: 'Sucursales' },
  { href: '/#redes', label: 'Síguenos' }
];
---

<header class="sticky top-0 z-40 border-b border-ink/[0.06] bg-cream/90 backdrop-blur-xl">
  <div class="page-shell flex min-h-[78px] items-center justify-between gap-3">
    <Logo />

    <nav class="hidden items-center gap-1 lg:flex" aria-label="Navegación principal">
      {links.map((link) => (
        <a
          href={link.href}
          class:list={[
            'rounded-full px-4 py-2 font-display text-sm font-medium transition hover:bg-white hover:text-brand-dark',
            currentPath === link.href ? 'text-brand-dark' : 'text-ink'
          ]}
        >
          {link.label}
        </a>
      ))}
    </nav>

    <div class="flex items-center gap-2">
      <BranchSelector client:load />
      <details class="group relative lg:hidden">
        <summary class="grid h-11 w-11 cursor-pointer list-none place-items-center rounded-full border border-ink/10 bg-white text-ink [&::-webkit-details-marker]:hidden" aria-label="Abrir menú">
          <svg class="h-5 w-5 group-open:hidden" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M4 7h16M4 12h16M4 17h16" /></svg>
          <svg class="hidden h-5 w-5 group-open:block" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="m6 6 12 12M18 6 6 18" /></svg>
        </summary>
        <nav class="absolute right-0 top-14 w-52 overflow-hidden rounded-2xl border border-ink/10 bg-white p-2 shadow-card" aria-label="Navegación móvil">
          {links.map((link) => <a href={link.href} class="block rounded-xl px-4 py-3 font-display text-sm font-medium text-ink transition hover:bg-brand-pale hover:text-brand-dark">{link.label}</a>)}
        </nav>
      </details>
    </div>
  </div>
</header>
