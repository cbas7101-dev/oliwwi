---
import { branches } from '../data/store';
---

<div class="fixed bottom-5 right-5 z-50 sm:bottom-6 sm:right-6" id="chat-widget">
  <div
    id="chat-panel"
    hidden
    class="absolute bottom-16 right-0 w-[min(85vw,320px)] overflow-hidden rounded-3xl border border-ink/10 bg-surface shadow-card"
    role="dialog"
    aria-modal="false"
    aria-labelledby="chat-panel-title"
  >
    <div class="bg-primary p-4 text-white">
      <p class="m-0 font-display text-[11px] font-semibold uppercase tracking-[0.18em] text-white/70">Chat Oliwwi</p>
      <h2 id="chat-panel-title" class="m-0 mt-1 font-display text-lg font-semibold">¿Desde qué ciudad nos escribes?</h2>
      <p class="m-0 mt-1 text-xs text-white/75">Tu mensaje llega al WhatsApp de esa tienda.</p>
    </div>
    <div class="grid max-h-[50dvh] gap-1.5 overflow-y-auto p-3">
      {branches.map((branch) => {
        const available = Boolean(branch.phoneInternational);
        const waUrl = available ? `https://wa.me/${branch.phoneInternational}` : '';
        return (
          <a
            href={waUrl}
            target="_blank"
            rel="noopener noreferrer"
            class:list={[
              'flex items-center gap-3 rounded-2xl border border-ink/[0.08] p-3 transition',
              available ? 'hover:-translate-y-0.5 hover:border-primary/40 hover:bg-primary-pale' : 'pointer-events-none opacity-50'
            ]}
            aria-disabled={available ? undefined : 'true'}
          >
            <span class="grid h-9 w-9 shrink-0 place-items-center rounded-full bg-primary-pale text-primary-dark" aria-hidden="true">
              <svg class="h-5 w-5" viewBox="0 0 24 24" fill="currentColor">
                <path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3 19.5 19.5 0 0 1-6-6 19.8 19.8 0 0 1-3-8.7A2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1.9.3 1.8.6 2.6a2 2 0 0 1-.4 2.1L8.1 9.6a16 16 0 0 0 6 6l1.2-1.2a2 2 0 0 1 2.1-.4c.9.3 1.7.5 2.6.6a2 2 0 0 1 1.7 2Z" />
              </svg>
            </span>
            <span class="min-w-0 flex-1">
              <span class="block font-display text-sm font-semibold text-ink">{branch.name}</span>
              <span class="block text-xs text-muted">{available ? branch.phoneDisplay : 'Próximamente'}</span>
            </span>
          </a>
        );
      })}
    </div>
  </div>

  <button
    type="button"
    id="chat-toggle"
    class="grid h-14 w-14 cursor-pointer place-items-center rounded-full bg-primary text-white shadow-card transition hover:bg-primary-dark active:scale-95"
    aria-label="Abrir chat por WhatsApp"
    aria-expanded="false"
    aria-haspopup="dialog"
  >
    <svg class="h-6 w-6" id="chat-icon-whatsapp" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
      <path d="M12 2a10 10 0 0 0-8.6 15.1L2 22l5-1.3A10 10 0 1 0 12 2Zm0 18.2c-1.5 0-3-.4-4.3-1.2l-.3-.2-3 .8.8-2.9-.2-.3A8.2 8.2 0 1 1 12 20.2Zm4.5-6.1c-.2-.1-1.5-.7-1.7-.8-.2-.1-.4-.1-.6.1-.2.2-.6.8-.8 1-.1.2-.3.2-.5.1a6.7 6.7 0 0 1-3.3-2.9c-.3-.4 0-.5.1-.7l.4-.5c.1-.2.1-.3 0-.5-.1-.1-.6-1.4-.8-1.9-.2-.5-.4-.4-.6-.4h-.5c-.2 0-.5.1-.7.3-.2.3-.9.9-.9 2.2s.9 2.5 1 2.7c.1.2 1.8 2.8 4.4 3.9.6.3 1.1.4 1.5.6.6.2 1.2.2 1.6.1.5-.1 1.5-.6 1.7-1.2.2-.6.2-1.1.2-1.2-.1-.1-.3-.2-.5-.3Z" />
    </svg>
    <svg class="hidden h-5 w-5" id="chat-icon-close" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" aria-hidden="true">
      <path d="m6 6 12 12M18 6 6 18" />
    </svg>
  </button>
</div>

<script>
  const widget = document.getElementById('chat-widget');
  const toggle = document.getElementById('chat-toggle');
  const panel = document.getElementById('chat-panel') as HTMLDivElement | null;
  const iconWhatsapp = document.getElementById('chat-icon-whatsapp');
  const iconClose = document.getElementById('chat-icon-close');

  function setPanel(open: boolean) {
    if (!panel || !toggle) return;
    panel.hidden = !open;
    iconWhatsapp?.classList.toggle('hidden', open);
    iconClose?.classList.toggle('hidden', !open);
    toggle.setAttribute('aria-expanded', String(open));
    toggle.setAttribute('aria-label', open ? 'Cerrar chat' : 'Abrir chat por WhatsApp');
  }

  toggle?.addEventListener('click', (event) => {
    event.stopPropagation();
    setPanel(Boolean(panel?.hidden));
  });

  document.addEventListener('click', (event) => {
    if (!panel?.hidden && widget && !widget.contains(event.target as Node)) {
      setPanel(false);
    }
  });

  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape') setPanel(false);
  });
</script>
