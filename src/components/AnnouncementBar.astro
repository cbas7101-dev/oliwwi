---
import { announcementMessages } from '../data/config';
---

<div class="bg-primary text-white" aria-label="Información de compra">
  <div class="relative mx-auto flex h-9 max-w-[1400px] items-center justify-center overflow-hidden px-4">
    {announcementMessages.map((message, i) => (
      <p
        class:list={[
          'announcement-item absolute inset-x-0 m-0 text-center font-display text-xs font-medium tracking-wide sm:text-sm',
          i === 0 && 'motion-reduce:static'
        ]}
      >
        {message}
      </p>
    ))}
  </div>
</div>
