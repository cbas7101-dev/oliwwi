---
import Logo from './Logo.astro';
import BranchSelector from './react/BranchSelector';
import { brands, navLinks, siteConfig } from '../data/config';

interface Props {
  currentPath: string;
}

const { currentPath } = Astro.props;
---

<!-- Announcement Bar -->
<div class="overflow-hidden bg-brand px-6 py-2 text-center font-display text-xs text-white sm:text-sm" aria-label="Información de compra">
  <div class="flex justify-start gap-8 whitespace-nowrap sm:justify-center">
    <span>Envío gratis en compras desde $60</span>
    <span class="hidden md:inline">Pide por WhatsApp directo a tu sucursal</span>
    <span class="hidden md:inline">Retiro en tienda gratis en 6 ciudades</span>
    <span class="hidden md:inline">Pago seguro online o contraentrega</span>
  </div>
</div>

<!-- Main Header -->
<header class="sticky top-0 z-40 border-b border-ink/[0.06] bg-cream/95 backdrop-blur-xl">
  <div class="page-shell flex items-center justify-between gap-3 min-h-[80px]">
    <!-- Logo -->
    <Logo href={siteConfig.url} />

    <!-- Search (desktop) -->
    <div class="hidden lg:flex-1 max-w-md mx-8">
      <form action={siteConfig.storeUrl + '/'} method="get" class="relative">
        <label for="header-search" class="sr-only">Buscar en la tienda</label>
        <input
          id="header-search"
          name="s"
          type="search"
          placeholder="Buscar productos, marcas..."
          class="w-full h-10 pl-10 pr-4 bg-white border border-ink/10 rounded-full text-sm text-ink placeholder:text-muted focus:outline-none focus:ring-2 focus:ring-brand focus:border-transparent transition"
        />
        <svg class="absolute left-3 top-1/2 -translate-y-1/2 h-5 w-5 text-muted pointer-events-none" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="11" cy="11" r="8" />
          <path d="M21 21l-4.35-4.35" />
        </svg>
      </form>
    </div>

    <!-- Navigation -->
    <nav class="hidden lg:flex items-center gap-1" aria-label="Navegación principal">
      {navLinks.map((link) => (
        <a
          href={link.href}
          data-cross-site={link.href.startsWith(siteConfig.storeUrl) || link.crossSite ? true : undefined}
          class:list={[
            'rounded-full px-4 py-2 font-display text-sm font-medium transition hover:bg-white hover:text-brand-dark',
            link.label === 'Inicio' && currentPath === '/' ? 'text-brand-dark bg-white shadow-soft' : 'text-ink'
          ]}
        >
          {link.label}
        </a>
      ))}

      <!-- Marcas Mega Menu -->
      <details class="group relative">
        <summary class="list-none rounded-full px-4 py-2 font-display text-sm font-medium text-ink transition hover:bg-white hover:text-brand-dark cursor-pointer flex items-center gap-1">
          Marcas
          <svg class="h-4 w-4 group-open:rotate-180 transition-transform" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M6 9l6 6 6-6" /></svg>
        </summary>
        <div class="absolute left-0 top-full mt-2 w-[520px] bg-white rounded-2xl border border-ink/10 shadow-card p-4 opacity-0 invisible group-open:opacity-100 group-open:visible transition-all duration-200 z-50">
          <div class="grid grid-cols-2 gap-4">
            {brands.map((brand) => (
              <a href={`${siteConfig.storeUrl}/product-category/${brand.slug}/`} data-cross-site class="flex items-center gap-3 p-2 rounded-xl hover:bg-brand-pale transition">
                <img src={brand.logo} alt={brand.name} class="h-8 w-auto object-contain" />
                <span class="font-display text-sm font-medium text-ink">{brand.name}</span>
              </a>
            ))}
          </div>
        </div>
      </details>
    </nav>

    <!-- Right side: Branch Selector + Cart -->
    <div class="flex items-center gap-2">
      <BranchSelector client:load />

      <!-- Cart icon linking to WP store cart -->
      <a
        href={siteConfig.storeUrl + '/cart/'}
        data-cross-site
        class="hidden lg:flex items-center justify-center w-11 h-11 rounded-full border border-ink/10 bg-white text-ink hover:bg-brand-pale hover:text-brand-dark hover:border-brand/30 transition"
        aria-label="Carrito de compras"
      >
        <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="9" cy="21" r="1" />
          <circle cx="20" cy="21" r="1" />
          <path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6" />
        </svg>
      </a>

      <!-- Mobile menu -->
      <details class="group relative lg:hidden">
        <summary class="grid h-11 w-11 cursor-pointer list-none place-items-center rounded-full border border-ink/10 bg-white text-ink [&::-webkit-details-marker]:hidden" aria-label="Abrir menú">
          <svg class="h-5 w-5 group-open:hidden" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M4 7h16M4 12h16M4 17h16" /></svg>
          <svg class="hidden h-5 w-5 group-open:block" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="m6 6 12 12M18 6 6 18" /></svg>
        </summary>
        <nav class="absolute right-0 top-14 w-56 overflow-hidden rounded-2xl border border-ink/10 bg-white p-2 shadow-card" aria-label="Navegación móvil">
          {navLinks.map((link) => (
            <a
              href={link.href}
              data-cross-site={link.href.startsWith(siteConfig.storeUrl) || link.crossSite ? true : undefined}
              class="block rounded-xl px-4 py-3 font-display text-sm font-medium text-ink transition hover:bg-brand-pale hover:text-brand-dark"
            >
              {link.label}
            </a>
          ))}
          <div class="pt-2 border-t border-ink/10">
            <a href={`${siteConfig.storeUrl}/shop/`} data-cross-site class="block rounded-xl px-4 py-3 font-display text-sm font-medium text-brand-dark">Todas las marcas</a>
          </div>
        </nav>
      </details>
    </div>
  </div>
</header>
